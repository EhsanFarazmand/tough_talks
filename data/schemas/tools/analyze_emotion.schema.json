{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tool: analyze_emotion",
  "type": "object",
  "name": "analyze_emotion",
  "description": "Analyze the emotional state of a conversation turn. Return a structured emotion radar reading.",
  "parameters": {
    "type": "object",
    "properties": {
      "speaker": {
        "type": "string",
        "enum": ["user", "other"],
        "description": "Who said this turn."
      },
      "text": {
        "type": "string",
        "description": "The exact utterance to analyze."
      }
    },
    "required": ["speaker", "text"]
  }
}
