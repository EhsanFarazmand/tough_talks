{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CulturalCalibration",
  "description": "Cross-cultural communication parameters for a conversation context.",
  "type": "object",
  "required": [
    "context",
    "communication_adjustments",
    "simulation_instructions",
    "opening_line_recommendations"
  ],
  "properties": {
    "context": {
      "type": "object",
      "required": ["cultural_context", "industry", "power_dynamic"],
      "properties": {
        "cultural_context": {
          "type": "string",
          "description": "Rich free-text description of the working environment — beyond a country name. E.g. 'Japanese corporate, traditional Tokyo software firm'."
        },
        "industry": {"type": "string"},
        "power_dynamic": {"type": "string"}
      }
    },
    "communication_adjustments": {
      "type": "object",
      "required": [
        "directness_level",
        "silence_norm",
        "face_saving_required",
        "typical_refusal_style"
      ],
      "properties": {
        "directness_level": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "0.0 very indirect, 1.0 very direct."
        },
        "silence_norm": {"type": "string"},
        "face_saving_required": {"type": "boolean"},
        "typical_refusal_style": {"type": "string"}
      }
    },
    "simulation_instructions": {"type": "string"},
    "opening_line_recommendations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "string"}
    }
  }
}
